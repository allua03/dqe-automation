pipeline {
    agent any

    environment {
        POSTGRES_SECRET = credentials('jenkins-postgres-credentials')
    }

    stages {
        stage('Install Dependencies') {
            steps {
                dir('PyTest DQ Framework') {
                    sh '''
                        python3 -m venv venv
                        . venv/bin/activate
                        pip install --upgrade pip
                        pip install -r requirements.txt
                    '''
                }
            }
        }

        stage('Run DQ Tests') {
            steps {
                dir('PyTest DQ Framework') {
                    catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                        sh '''
                            . venv/bin/activate
                            pytest tests -m "parquet_data" \
                                --db_host="postgres" \
                                --db_port="5432" \
                                --db_name="mydatabase" \
                                --db_user=$POSTGRES_SECRET_USR \
                                --db_password=$POSTGRES_SECRET_PSW \
                                --html=html_report/index.html \
                                --self-contained-html
                        '''
                    }
                }
            }
        }

        stage('Archive Test Report') {
            steps {
                dir('PyTest DQ Framework') {
                    archiveArtifacts artifacts: 'html_report/**', allowEmptyArchive: true

                    script {
                        try {
                            publishHTML(target: [
                                allowMissing: false,
                                keepAll: true,
                                reportDir: 'html_report',
                                reportFiles: 'index.html',
                                reportName: 'HTML Test Report'
                            ])
                        } catch (NoSuchMethodError e) {
                            echo "HTML Publisher plugin not installed — skipping publishHTML, report is still archived above."
                        }
                    }
                }
            }
        }
    }
}
