pipeline {
	agent any

	options {
		timestamps()
	}

	environment {
		DB_HOST = 'postgres'
		DB_PORT = '5432'
		DB_NAME = 'mydatabase'
		POSTGRES_SECRET = credentials('POSTGRES_SECRET')
	}

	stages {
		stage('Install dependencies') {
			steps {
				dir('PyTest DQ Framework') {
					sh 'python3 -m pip install --upgrade pip'
					sh 'python3 -m pip install -r requirements.txt'
				}
			}
		}

		stage('Run Parquet DQ suite') {
			steps {
				dir('PyTest DQ Framework') {
					catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
						sh '''
							python3 -m pytest tests -m parquet_data \\
							  --db_host="$DB_HOST" \\
							  --db_port="$DB_PORT" \\
							  --db_name="$DB_NAME" \\
							  --db_user="$POSTGRES_SECRET_USR" \\
							  --db_password="$POSTGRES_SECRET_PSW" \\
							  --html=html_report/report.html \\
							  --self-contained-html
						'''
					}
				}
			}
		}

		stage('Publish and archive report') {
			steps {
				dir('PyTest DQ Framework') {
					archiveArtifacts artifacts: 'html_report/**', allowEmptyArchive: false
					publishHTML(target: [
						allowMissing: false,
						keepAll: true,
						alwaysLinkToLastBuild: true,
						reportDir: 'html_report',
						reportFiles: 'report.html',
						reportName: 'Parquet DQ HTML Report'
					])
				}
			}
		}
	}

	post {
		always {
			echo 'DQ pipeline finished. Review the archived HTML report for check results.'
		}
	}
}
